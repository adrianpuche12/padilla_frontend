# PRO-008: template de nginx. La imagen oficial reemplaza ${BACKEND_UPSTREAM} al arrancar
# (envsubst sobre /etc/nginx/templates). Default en el Dockerfile: padilla-backend-dev:8080.
# En cada servicio Swarm: --env BACKEND_UPSTREAM=<servicio-backend>:8080
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy reverso al backend — evita mixed-content (frontend HTTPS, backend HTTP)
    location /api/ {
        # PRO-120: sin esto rige el limite de 1 MB de nginx y una foto de celular daba 413.
        # 52m = video de hasta 50 MB (limite del backend) + el resto del multipart.
        client_max_body_size 52m;
        proxy_request_buffering off;
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /actuator/ {
        proxy_pass http://${BACKEND_UPSTREAM}/actuator/;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.js$ {
        add_header Cache-Control "no-cache, must-revalidate";
        expires 0;
    }
}
